# mkexp environment for a hybrid run on a single NVIDIA GB10 (DGX Spark), in
# the container built from config/docker/gb10/Dockerfile: the atmosphere on the
# one GPU, the ocean on the CPU cores, one MPMD job, coupled through YAC.
#
# This is the Spark-sized counterpart of run/mkexp/environments/dolpung_hybrid,
# and it differs from it in the three ways the hardware forces:
#
#   - one node, one GPU, one NUMA domain, 20 cores. Everything dolpung_hybrid
#     does to spread ranks over 4 GPUs, 4 NUMA domains and 4 InfiniBand NICs
#     collapses to "rank 0 gets the GPU, the rest get cores".
#   - no scheduler. batch_command runs the follow-up job in the foreground
#     rather than submitting it, and there are no #SBATCH headers, because no
#     gb10_hybrid.tmpl exists and DEFAULT.run.tmpl therefore falls back to
#     mkexp/environments/DEFAULT.tmpl.
#   - no srun. mkexp's hybrid run script launches the job as
#     "${START} --multi-prog icon_mpmd.conf"; [MPI] command below points at
#     mpmd-launch.sh, which translates that into OpenMPI's MPMD form.
#
# Found by mkexp through MKEXP_PATH; see make-experiment.sh.

VERSION_ = $$Id: config/docker/gb10/mkexp/environments/gb10_hybrid.config 1 2026-09-01 $$

INPUT_ROOT = /pool/data

# MODEL_ROOT is deliberately left at mkexp's default, which resolves to
# $SRC_DIR/experiments/$EXP_ID -- the location ICON's own documentation gives
# for mkexp, already excluded by .gitignore, and the same root build-icon.sh
# puts build_dir, py_env and install under. Everything scratch then lives in
# one place inside the checkout.

# Blocking parameter for grid decomposition
#  nproma for ATMO and OCEAN,      ICON default: 1 if nblocks_c and nblocks_e are not set
DEFAULT_ATMO_NPROMA =
DEFAULT_OCEAN_NPROMA = 8
#  nproma_sub for radiation,       ICON default: computed based on nblocks_sub
DEFAULT_ATMO_NPROMA_SUB =
#  nblocks_c for ATMO and OCEAN,   ICON default: 0
#  One block per atmosphere rank: on a GPU the whole domain wants to be one
#  long vector, and there is exactly one atmosphere rank here.
DEFAULT_ATMO_NBLOCKS_C = 1
DEFAULT_OCEAN_NBLOCKS_C =
#  nblocks_sub used for radiation, ICON default: 1 if nproma_sub not set
DEFAULT_ATMO_NBLOCKS_SUB = 6

# System optimizations
DEFAULT_USE_CUDA_GRAPHS = true

[jobs]
  # No scheduler: "submitting the next job" is running it. The generated
  # scripts are bash, so this cannot be `sh` (dash) -- they use [[ ]].
  batch_command = bash
  ksh = /bin/bash
  hostnames_command = hostname

  # Hardware parameters
  default_gpus_per_node = 1    # 1x GB10
  default_cpus_per_node = 20
  default_cpu_threads_per_task = 1
  hardware_threads =

  [[run]]
    use_gpus = true
    use_cpu_mask = false
    # Both are single-node concepts here: there is nothing to distribute over.
    use_hostfile = false
    use_mpmd = true
    nodes = 1
    stack_size = unlimited
    [[[env]]]
      # The image already sets OMP_DYNAMIC/OMP_SCHEDULE/OMP_STACKSIZE,
      # UCX_TLS/UCX_HANDLE_ERRORS and the OMPI_MCA_* workarounds that a
      # container without InfiniBand needs; see config/docker/gb10/README.md.
      # What is left is what belongs to the run rather than to the machine.
      #
      # sysv, not the image's default sm. `sm` lets UCX pick its POSIX shared
      # memory transport, which allocates out of /dev/shm, and /dev/shm is 64 MB
      # unless the container was started with --shm-size. At 17 ranks UCX runs
      # out of it while growing its mpool and *segfaults* inside MPI_Init
      # (uct_mm_iface_t_init -> ucs_mpool_grow) rather than reporting a full
      # filesystem. SysV segments come from the kernel instead, and its limits
      # here are effectively unbounded. Starting the container with
      # --shm-size=8g, as config/docker/gb10/README.md says to, makes the
      # default work again; this setting is what makes the run work either way.
      UCX_TLS = 'self,sysv,cuda_copy,cuda_ipc'
      NVCOMPILER_ACC_DEFER_UPLOADS = 1
      NVCOMPILER_TERM = trace
      NVCOMPILER_ACC_USE_GRAPH = 1
      MALLOC_CONF = thp:never
    [[[hybrid]]]
      [[[[atm]]]]
        # Overridden by the experiment config -- the two builds live under
        # $ICON_ENV_DIR/build_dir, which defaults to $SRC_DIR/experiments.
        exec = eval(feedback.die("please set jobs:run:hybrid:atm:exec to the GPU build's bin/icon"))
        gpus_per_node = $default_gpus_per_node
      [[[[oce]]]]
        exec = eval(feedback.die("please set jobs:run:hybrid:oce:exec to the CPU build's bin/icon"))
        # Ocean ranks. 20 cores, minus the atmosphere rank, minus a couple left
        # for its host-side work and the driver's own threads.
        cpus_per_node = 16
        [[[[[env]]]]]
          OMP_NUM_THREADS = $default_cpu_threads_per_task
          ICON_THREADS = $OMP_NUM_THREADS
          OMP_WAIT_POLICY = active
          # These ranks have no visible GPU (see run_gb10_hybrid.tmpl), so the
          # image's CUDA transports are genuinely unavailable to them; naming
          # them anyway produces a warning per rank. sysv rather than sm for the
          # /dev/shm reason given above.
          UCX_TLS = 'self,sysv'
          UCX_WARN_UNUSED_ENV_VARS = n
      [[[[hiopy]]]]
        [[[[[env]]]]]
          OMP_NUM_THREADS = $default_cpu_threads_per_task
          OMP_WAIT_POLICY = active
          # Same as the ocean: these ranks hide the GPU, so the CUDA transports
          # in the job-level list are genuinely unavailable to them.
          UCX_TLS = 'self,sysv'
          UCX_WARN_UNUSED_ENV_VARS = n

  [[mon]]
    [[[env]]]

[MPI]
  # Reads the icon_mpmd.conf mkexp writes and launches it with mpirun.
  command = $SRC_DIR/config/docker/gb10/mpmd-launch.sh
