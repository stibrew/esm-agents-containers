# Put ICON's output fields into YAC, without configuring hiopy.
#
# output/hiopy_core does two separate jobs: it tells ICON to hand its output to
# the coupler (coupled_to_output = true plus output_nml entries with
# filetype 999), and it configures hiopy's data request and worker ranks. The
# two YACO setups of issue #23 want the first and must not have the second --
# naming a [hiopy] section anywhere in the merged configuration makes
# run_gb10_hybrid.tmpl allocate hiopy workers and write a hiopy MPMD context,
# and mkexp's .hide cannot undo that because only the namelist formatter
# honours it.
#
# So this is hiopy_core's first job alone, written out rather than layered on
# top of it: the atmosphere and land groups it defines, under the same names
# and with the same variable-list keys, plus a height-level group that
# hiopy_core does not have. The ocean groups are left out because the common
# output set (output/io_common.config) has no ocean fields; there is nothing
# here to hide afterwards.
#
# Layer output/io_common.config after this one, which is where the variable
# lists and the frequencies come from.
#
# The consumer -- the yaco binary or hiopy's fdb-worker -- is configured
# entirely outside mkexp, by hiopy's fdb-worker-configure from the same lists,
# and joins the job through the [yaco] section of the experiment config. It
# archives what it receives as GRIB2 messages in FDB.

VERSION_ = $$Id: mkexp/options/output/io_coupled_core.config 2 2026-09-09 $$

HIGH_FREQUENCY_INTERVAL = PT1H
LOW_FREQUENCY_INTERVAL = PT1H

[namelists]

  # Overridden by output/io_common.config; the defaults are here so that this
  # option is usable on its own, and are a subset of the common set that
  # earlier runs have already produced through this path. Same key names as
  # hiopy_core: *_hf are the instantaneous lists, *_lf the hourly means (the
  # reduction is the consumer's choice, ICON puts every step either way).
  atm_2d_hf = "uas, vas, sfcwind, cllvi, pres_sfc, tas, clt, prw, pres_msl, clivi"
  atm_2d_lf = "tauu, tauv, prls, evspsbl, pr, hfss, hfls, rsdt, rsds, rlds"
  atm_3d_pl = "temp, ua, va, hus, clw"
  # The 19 DestinE production levels, in Pa. ICON merges the p_levels of all
  # output_nml blocks of a domain into one sorted set that defines the YAC
  # collection order, so no other pressure-level list may be added alongside.
  pressure_levels = "100, 500, 1000, 2000, 3000, 5000, 7000, 10000, 15000, 20000, 25000, 30000, 40000, 50000, 60000, 70000, 85000, 92500, 100000"
  atm_3d_hl = "ua, va"
  height_levels = "100"
  land_2d_hf = "hydro_weq_snow_box"
  land_2d_lf = "hydro_runoff_box, hydro_drainage_box"
  land_3d = "sse_t_soil_sl_box"

  [[NAMELIST_atm, NAMELIST_oce]]
    [[[coupling_mode_nml]]]
      # The whole point: output leaves through the coupler instead of through
      # ICON's own I/O ranks. run_gb10_hybrid.tmpl forces num_io_procs to 0 for
      # both components when a [yaco] or [hiopy] section is present, which is
      # what this setting assumes.
      coupled_to_output = true

  [[NAMELIST_atm]]
    # filetype 999 is the coupled-output writer: mo_output_coupling registers
    # each variable in this list as a YAC field on the atm_output component
    # rather than writing it to a file. file_interval P999Y and the model time
    # step are hiopy_core's values and mean "never roll over, offer every
    # step"; the actual output frequency is the coupling_period that the
    # consumer asks for, not this. The output_interval has to stay the model
    # step: it is what refreshes the vertically interpolated fields before
    # each put, and an hourly mean of a field refreshed hourly is no mean.
    #
    # Note the quoting: comments in a [[NAMELIST_*]] section are copied into
    # the generated namelist, and mkexp writes that namelist from an
    # UNQUOTED heredoc (cat > NAMELIST_atm << EOF). Backticks here are
    # therefore command substitution, and a backquoted pl:: in a comment
    # makes the run script try to execute pl:: before ICON ever starts. It
    # only produced a "command not found" line, but it is shell execution out
    # of a comment; do not use backticks in a namelist comment.
    [[[output_nml hiopy_atm_2d]]]
      .hide = $without_atmo
      operation =
      output_interval = $ATMO_TIME_STEP
      ml_varlist = 'eval("$atm_2d_lf, $atm_2d_hf".replace(",", " ").split())'
      filetype = 999
      file_interval = P999Y
      include_last = true
    [[[output_nml hiopy_atm_3d_pl]]]
      .hide = $without_atmo
      operation =
      output_interval = $ATMO_TIME_STEP
      # Pressure-level fields reach YAC with a 'pl::' prefix that
      # mo_output_coupling.f90:147 adds, so the YACO coupling config asks for
      # 'pl::temp' where this list says 'temp'. ua and va are renamed to u and
      # v by the output_nml_dict before the match, so they are 'pl::u' and
      # 'pl::v'. See hiopy/workers/fdb_worker/_fields.py.
      pl_varlist = 'eval("$atm_3d_pl".replace(",", " ").split())'
      p_levels = eval([$pressure_levels])
      filetype = 999
      file_interval = P999Y
      include_last = true
    [[[output_nml hiopy_atm_hl]]]
      .hide = $without_atmo
      operation =
      output_interval = $ATMO_TIME_STEP
      # Height-level fields carry an 'hl::' prefix the same way
      # (mo_output_coupling.f90:149): 'hl::u' and 'hl::v' at 100 m.
      hl_varlist = 'eval("$atm_3d_hl".replace(",", " ").split())'
      h_levels = eval([$height_levels])
      filetype = 999
      file_interval = P999Y
      include_last = true
    # JSBACH's variables are registered by the atmosphere process, so the land
    # groups live in NAMELIST_atm and their fields are on atm_output too.
    [[[output_nml hiopy_land_2d]]]
      .hide = $without_land
      operation =
      output_interval = $ATMO_TIME_STEP
      ml_varlist = 'eval("$land_2d_lf, $land_2d_hf".replace(",", " ").split())'
      filetype = 999
      file_interval = P999Y
      include_last = true
    [[[output_nml hiopy_land_3d]]]
      .hide = $without_land
      operation =
      output_interval = $ATMO_TIME_STEP
      # Soil-layer variables: 5-level collections on the JSBACH soil axis.
      ml_varlist = 'eval("$land_3d".replace(",", " ").split())'
      filetype = 999
      file_interval = P999Y
      include_last = true
