# The common output set for the three-way IO-tool comparison.
#
# Issue #23 asks for YACO to be merged into hiopy. To judge the port we run the
# same experiment three ways -- through hiopy, through YACO's C++ binary, and
# through the Python port -- and compare the archives of the two YACO setups
# message for message, and the wall clock of all three. That is only a
# comparison of the IO tools if all three are asked for *the same fields, on
# the same grid, at the same frequency*, which is what this option pins down.
# It is layered after whichever option puts the fields into YAC --
# output/hiopy_core for setup A, output/io_coupled_core for the two YACO
# setups -- and overrides it, so put it after that one in EXP_OPTIONS.
#
# The half of the request that only hiopy understands (its data-request groups
# and its healpix hierarchy) lives in output/io_hiopy_request.config instead.
# It has to be separate: mkexp's .hide is honoured only by the namelist
# formatter, so a [hiopy] section mentioned anywhere in the merged config
# still makes "hiopy is defined" true in the run template and still allocates
# hiopy worker ranks -- which is exactly wrong for a YACO run.
#
# The set, and where it comes from:
#
#   It is YACO's DestinE production request -- scripts/configure/
#   destine_phase_2/autosubmit_production in the YACO repository
#   (generate_yaco_config_coarse_non_monthly.sh and its coupling.yaml) --
#   restricted to what this experiment can deliver: the hourly ATMOSPHERE and
#   LAND collections. The ocean collections are daily averages, which a
#   three-hour run never completes, and would come from a component this
#   experiment names oce_output where production says ocean_output; the
#   monthly stream cannot be produced by a three-hour run either; orog and
#   fract_box are daily. Everything that is left is here, under the names
#   ICON registers the variables by. Each one was traced to its add_var in
#   the AES or ICON-Land sources; those not yet seen in a run are marked.
#
#   Two time reductions, both hourly. Production couples the instantaneous
#   collections with time_config_1h_inst and the flux-like ones with
#   time_config_1h_avg. ICON does not choose between them: it puts every
#   field every model step, and the consumer's coupling asks YAC for either
#   the instantaneous value or the hourly mean. So the split below is only a
#   split of the *lists*; hiopy turns it into a point and a mean group
#   (io_hiopy_request.config), and the YACO configuration generator turns it
#   into time_reduction none and average.
#
#   One healpix zoom level, 6. hiopy's z6/z5/z4/z3 hierarchy chains nnn:4
#   couplings between its own ranks to build the coarser levels; YACO only ever
#   defines one grid, so the hierarchy is a hiopy feature and not common
#   ground. Zoom 6 is 49152 cells against R2B4's 20480, so the one level that
#   remains is a genuine conservative interpolation and not a downsampling.
#
#   The 19 production pressure levels, 1 hPa to 1000 hPa, in Pa. ICON merges
#   the p_levels of every output_nml of a domain into one sorted set and the
#   YAC collection index follows that set, so every pressure-level group has
#   to name exactly these 19 and nothing else -- an extra level anywhere would
#   shift the collection under the consumer's level list. Index 0 is 100 Pa.
#
#   One height level, 100 m, for the production height_levels_u/v
#   collections. hl_varlist fields reach YAC with an hl:: prefix, the same
#   way pl_varlist fields carry pl::. No run in 14_artefacts has exercised
#   hl_varlist yet; mo_output_coupling handles level_type_hl exactly like
#   level_type_pl, and the pressure-level path is run-proven.
#
#   Land: JSBACH's varlists belong to the atmosphere process, so the land
#   groups are output_nml blocks of NAMELIST_atm and their fields sit on the
#   same atm_output component as the atmosphere's. The soil variables are
#   5-level collections (the JSBACH soil axis).
#
# Nothing here is a file: every output_nml has filetype 999, which declares
# the variables to the coupler and opens nothing. The archives are written by
# the consumer -- GRIB2 messages into FDB for the two YACO setups, a Zarr
# store for hiopy.

VERSION_ = $$Id: mkexp/options/output/io_common.config 2 2026-09-09 $$

# hiopy_core defaults to PT3H and P1D. Both are pinned to the same interval
# here: production's two reductions are both hourly, so the "high" and "low"
# frequency groups of hiopy_core differ only in their time method (point for
# hf, mean for lf), and one YACO instance covers the whole request.
HIGH_FREQUENCY_INTERVAL = PT1H
LOW_FREQUENCY_INTERVAL = PT1H

[namelists]

  # hiopy_core reads *_hf as the point (instantaneous) group and *_lf as the
  # mean group -- see [[hiopy]] there -- and io_coupled_core keeps the same
  # names so that one definition serves both.
  #
  # Instantaneous 2d atmosphere, hourly: production's 1h_inst collections.
  # tdps is the 2 m dew point (production names the collection dew2); tcw,
  # tdps and ts_rad are source-verified but not yet seen in a run here.
  atm_2d_hf = "uas, vas, tdps, tcw, sfcwind, cllvi, pres_sfc, ts_rad, tas, clt, prw, pres_msl, clivi"
  # Hourly averages: production's 1h_avg collections. The net and clear-sky
  # radiation terms (rsns, rsnt, rlns, rlnt, rsnscs, rsntcs, rlnscs, rlntcs)
  # are only allocated and computed when an output_nml asks for them, which
  # this list does; they are source-verified, not yet run-proven.
  atm_2d_lf = "tauu, tauv, prls, evspsbl, pr, hfss, hfls, rsdt, rsds, rlds, rsns, rsnt, rlns, rlnt, rsnscs, rsntcs, rlnscs, rlntcs"
  # Pressure levels, instantaneous. ua and va are rewritten to u and v by the
  # output_nml_dict (dict.txt) before ICON matches the list, so they reach YAC
  # as pl::u and pl::v; the rest keep their names behind the pl:: prefix.
  # geop is the full geopotential (production's param 129), not gpsm, which is
  # the geopotential above the surface. hur, omega, pv and geop are
  # source-verified, not yet run-proven.
  atm_3d_pl = "temp, ua, va, hus, hur, clw, omega, pv, geop"
  pressure_levels = "100, 500, 1000, 2000, 3000, 5000, 7000, 10000, 15000, 20000, 25000, 30000, 40000, 50000, 60000, 70000, 85000, 92500, 100000"
  # Height levels, instantaneous: the 100 m wind, hl::u and hl::v.
  atm_3d_hl = "ua, va"
  height_levels = "100"
  # Land, on the atmosphere process. hydro_weq_snow_box is instantaneous, the
  # runoff and drainage fluxes are hourly means.
  land_2d_hf = "hydro_weq_snow_box"
  land_2d_lf = "hydro_runoff_box, hydro_drainage_box"
  # Soil-layer collections, instantaneous, 5 levels each.
  # hydro_vol_weq_soil_sl_box is source-verified; its sibling
  # hydro_wtr_soil_sl_box is what earlier runs used.
  land_3d = "sse_t_soil_sl_box, hydro_vol_weq_soil_sl_box"

  [[NAMELIST_atm]]
    # hiopy_core has no height-level group, so the hl output_nml is defined
    # here for setup A; output/io_coupled_core carries the same block for the
    # YACO setups. Keys and values follow hiopy_core's pressure-level block:
    # filetype 999 declares the fields to the coupler, output_interval is the
    # model step so the vertical interpolation is refreshed for every put,
    # and the hourly frequency is the consumer's coupling period.
    [[[output_nml hiopy_atm_hl]]]
      .hide = $without_atmo
      operation =
      output_interval = $ATMO_TIME_STEP
      hl_varlist = 'eval("$atm_3d_hl".replace(",", " ").split())'
      h_levels = eval([$height_levels])
      filetype = 999
      file_interval = P999Y
      include_last = true
  [[NAMELIST_oce]]
    # No ocean output in the common set.
    [[[output_nml hiopy_oce_2d]]]
      .hide = true
    [[[output_nml hiopy_oce_3d]]]
      .hide = true
