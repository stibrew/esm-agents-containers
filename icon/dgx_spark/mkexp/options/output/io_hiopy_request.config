# The hiopy half of the common output set (setup A only).
#
# Split out of output/io_common.config because naming a [hiopy] section at all
# is what makes run_gb10_hybrid.tmpl allocate hiopy worker ranks and write a
# hiopy MPMD context. The YACO setups share io_common but must not see this.
#
# Layer it after output/hiopy_core and output/io_common.
#
# hiopy_core's data-request groups are reused, with io_common's lists in them:
# the "hf" groups are its point (instantaneous) groups and the "lf" groups its
# mean groups, both at PT1H here, which is production's 1h_inst / 1h_avg
# split. Two of hiopy_core's groups carry the wrong time method for
# production and are corrected below; one group -- the 100 m wind -- does not
# exist in hiopy_core and is added. Everything else hiopy_core defines is
# hidden.
#
# What hiopy stores differs from the GRIB the YACO setups archive in two
# respects that are hiopy's, not the request's: the field names are the
# request names (ua, u100, ...) rather than GRIB shortNames, and there is no
# unit scaling (clt stays a fraction, hydro_weq_snow_box stays in m) -- the
# production scale factors live in YACO's metadata, and the port carries them
# the same way.

VERSION_ = $$Id: mkexp/options/output/io_hiopy_request.config 2 2026-09-09 $$

[namelists]

  [[hiopy]]
    # Not part of the common set.
    [[[atm_3d_pl850]]]
      .hide = true
    [[[ocean_2d]]]
      .hide = true
    [[[ocean_3d_full]]]
      .hide = true
    [[[ocean_3d_half]]]
      .hide = true
    [[[hamocc_2d]]]
      .hide = true
    [[[hamocc_3d_full]]]
      .hide = true
    [[[carbon_cycle_2d]]]
      .hide = true
    [[[carbon_cycle_3d_full]]]
      .hide = true

    # The four hiopy_core groups that already have the right time method:
    # atm_2d hf and land_2d hf are point, atm_2d lf and land_2d lf are mean,
    # and with both intervals at PT1H they only need their variables, which
    # they take from io_common's lists. Nothing to set.

    # Production's pressure-level collections are instantaneous
    # (time_config_1h_inst); hiopy_core's only pressure-level group is mean.
    [[[atm_3d_pl lf]]]
      time_method = point
    # Likewise the soil-layer collections.
    [[[land_3d lf]]]
      time_method = point

    # The 100 m wind. hiopy has no notion of an hl:: prefix, so this is a
    # plain 3d group on a one-level height axis, and the YAC names come from
    # the [hiopy] var_names_dict below. Group names route the request: "atm"
    # picks atm_output/icon_atmos_grid and "3d" the 3d settings
    # (run/mkexp/defaults/hiopy/create_datarequest_config.py). The names
    # cannot be ua and va: those are the pressure-level variables in the same
    # PT1H point Zarr group.
    [[[atm_3d_hl]]]
      .hide = $without_atmo
      is_pressure_level = false
      name_of_zaxis = height
      positive_direction = up
      levels_needed = eval([$height_levels])
    [[[atm_3d_hl hf]]]
      variables = u100, v100
      time_res = $HIGH_FREQUENCY_INTERVAL
      time_method = point

[hiopy]
  # Both groups are hourly, so one aggregation.
  time_agg = $HIGH_FREQUENCY_INTERVAL,
  [[grid]]
    type = healpix
    # Two levels, coarsest first (the order is irrelevant -- init_hierarchy.py
    # takes np.max as the parent). Only the FINEST is received from ICON:
    # run/mkexp/defaults/hiopy/init_hierarchy.py sets `hiopy::parent` on every
    # group whose zoom is below the maximum, and
    # hiopy/configure/configure.py:add_variable() then writes
    # `hiopy::yac_source` only when the group has no parent, giving a parented
    # group `hiopy::interpolation_stack = "- nnn:\n    n: 4"` instead.
    # hiopy/worker.py falls back to `v.parent` for those, coupling them from
    # hiopy's own component and the parent variable's grid. So z5 is hiopy
    # coarsening its own z6 -- the average of the four child cells -- not a
    # second interpolation out of the model.
    zoom_levels = 5, 6
  [[var_names_dict]]
    # The height-level names of the two wind components, as mo_output_coupling
    # registers them; hiopy_core already maps ua/va to pl::u/pl::v.
    u100 = hl::u
    v100 = hl::v
