#!/bin/bash

# ICON
#
# ------------------------------------------
# Copyright (C) 2004-2026, DWD, MPI-M, DKRZ, KIT, ETH, MeteoSwiss
# Contact information: icon-model.org
# See AUTHORS.TXT for a list of authors
# See LICENSES/ for license information
# SPDX-License-Identifier: BSD-3-Clause
# ------------------------------------------
#
# CPU configure wrapper for the NVIDIA GB10 (DGX Spark) container built from
# config/docker/gb10/Dockerfile. Same compiler (nvfortran) and the same library
# set as gb10.gpu.nvhpc, with every accelerator flag removed and OpenMP on --
# this is the binary that runs the ocean in a hybrid job, and it must not touch
# the GPU the atmosphere ranks are using.
#
#     mkdir -p build_cpu && cd build_cpu
#     /path/to/icon/config/docker/gb10/gb10.cpu.nvhpc
#     make -j"$(nproc)"

set -eu
unset CDPATH
ulimit -c 0

script_dir=$(cd "$(dirname "$0")"; pwd)
icon_dir=${ICON_DIR:-$(cd "${script_dir}/../../.."; pwd)}

NVHPC_ROOT="${NVHPC_ROOT:-/opt/nvidia/hpc_sdk/current}"
MPI_ROOT="${MPI_ROOT:-${NVHPC_ROOT}/comm_libs/mpi}"
NETCDFF_ROOT="${NETCDFF_ROOT:-/opt/netcdf-fortran}"

multiarch="$(uname -m)-linux-gnu"

STDCPP_LIBS='-lstdc++'

HDF5_INCLUDE="/usr/include/hdf5/serial"
HDF5_LIBDIR="/usr/lib/${multiarch}/hdf5/serial"
HDF5_LIBS='-lhdf5_hl -lhdf5'

NETCDF_ROOT="/usr"
NETCDF_LIBS='-lnetcdf'
NETCDFF_LIBS='-lnetcdff'

BLAS_LAPACK_LIBS='-llapack -lblas'

FYAML_LIBS='-lfyaml'
XML2_ROOT='/usr'
XML2_LIBS='-lxml2'

################################################################################

# LDSHARED is overridden because the bundled Python bindings (YAC's, built when
# --enable-bundled-python includes yac) are linked by setuptools, which takes its
# link command from the sysconfig of the interpreter -- and that interpreter was
# built with gcc. Its LDSHARED carries -fwrapv, which nvc rejects outright:
#     nvc-Error-Unknown switch: -fwrapv
# Replacing it with "<CC> -shared" keeps the flags that come from this file and
# drops the ones that describe someone else's compiler.
BUILD_ENV="export LD_LIBRARY_PATH=\"${HDF5_LIBDIR}:${NETCDFF_ROOT}/lib:\${LD_LIBRARY_PATH:-}\"; export LIBRARY_PATH=\"/usr/lib/${multiarch}:\${LIBRARY_PATH:-}\"; export LDSHARED=\"${MPI_ROOT}/bin/mpicc -shared\";"

CC="${MPI_ROOT}/bin/mpicc"
CFLAGS='-g -O2'

ICON_YAC_CFLAGS='-fortranlibs'

CXX="${NVHPC_ROOT}/compilers/bin/nvc++"
CXXFLAGS='-g -O2'

CPPFLAGS="-I${HDF5_INCLUDE} -I${NETCDF_ROOT}/include -I${XML2_ROOT}/include/libxml2"

FC="${MPI_ROOT}/bin/mpifort"
FCFLAGS="-I${NETCDFF_ROOT}/include -g -O2 -Mrecursive -Mallocatable=03 -Mstack_arrays -Minfo=inline"

ICON_LDFLAGS="-c++libs -nvmalloc" # avoid passing it to g++ compiler as linker flags
LDFLAGS="-L${HDF5_LIBDIR} -L/usr/lib/${multiarch} -L${NETCDFF_ROOT}/lib"

LIBS="-Wl,--as-needed ${STDCPP_LIBS} ${XML2_LIBS} ${FYAML_LIBS} ${BLAS_LAPACK_LIBS} ${NETCDFF_LIBS} ${NETCDF_LIBS} ${HDF5_LIBS}"

MPI_LAUNCH="${MPI_ROOT}/bin/mpiexec"

EXTRA_CONFIG_ARGS='--disable-mpi-checks --enable-openmp --enable-bundled-python=mtime'

################################################################################

"${icon_dir}/configure" \
BUILD_ENV="${BUILD_ENV}" \
CC="${CC}" \
CFLAGS="${CFLAGS}" \
CPPFLAGS="${CPPFLAGS}" \
CXX="${CXX}" \
CXXFLAGS="${CXXFLAGS}" \
FC="${FC}" \
FCFLAGS="${FCFLAGS}" \
ICON_YAC_CFLAGS="${ICON_YAC_CFLAGS}" \
LDFLAGS="${LDFLAGS}" \
ICON_LDFLAGS="${ICON_LDFLAGS}" \
LIBS="${LIBS}" \
MPI_LAUNCH="${MPI_LAUNCH}" \
${EXTRA_CONFIG_ARGS} \
"$@"

for arg in "$@"; do
  case $arg in
    -help | --help | --hel | --he | -h | -help=r* | --help=r* | --hel=r* | --he=r* | -hr* | -help=s* | --help=s* | --hel=s* | --he=s* | -hs*)
      test -n "${EXTRA_CONFIG_ARGS}" && echo '' && echo "This wrapper script ('$0') calls the configure script with the following extra arguments, which might override the default values listed above: ${EXTRA_CONFIG_ARGS}"
      exit 0 ;;
  esac
done

# Copy runscript-related files when building out-of-source:
if test $(pwd) != $(cd "${icon_dir}"; pwd); then
  echo "Copying runscript input files from the source directory..."
  rsync -uavz ${icon_dir}/run . --exclude='*.in' --exclude='.*' --exclude='standard_*' --exclude=mkexp
  ln -sf -t run/ ${icon_dir}/run/{standard_*,mkexp}
  for dir in \
    'externals/art/runctrl_examples' \
    'externals/ecrad/data' \
    'externals/jsbach/data'
  do
    src="${icon_dir}/${dir}"
    test -d "${src}" && mkdir -p "${dir}" && rsync -uavz "${src}/" "${dir}"
  done
  rsync -uavz ${icon_dir}/make_runscripts .
  rsync -uavz ${icon_dir}/scripts .
  ln -sf ${icon_dir}/data
  ln -sf ${icon_dir}/vertical_coord_tables
fi
