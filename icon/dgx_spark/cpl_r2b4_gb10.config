#
# Coupled AES R2B4 atmosphere / R2B4 ocean on a single NVIDIA GB10 (DGX Spark):
# the atmosphere on the GPU, the ocean on the CPU cores, one MPMD job, coupled
# through YAC.
#
# This is run/mkexp/types/AES/coupled-R02B04L90.config, inlined rather than
# pulled in with EXP_TYPE and then changed where a single Spark differs from
# four dolpung nodes. Everything not marked "gb10:" below is that file
# verbatim, so a diff against it shows exactly what this machine costs:
#
#   run/mkexp/types/AES/coupled-R02B04L90.config
#
# The changes are, in order of how much they matter:
#
#   - 17 ranks instead of ~1000. 1 atmosphere rank on the one GPU, 16 ocean
#     ranks on the cores, and no dedicated I/O or restart ranks at all --
#     20 cores do not stretch to 6 atmosphere I/O ranks plus 2 ocean ones.
#     num_io_procs = 0 makes the worker ranks write, which is slower and
#     entirely adequate at R2B4.
#   - one chunk of three hours instead of three days, so that a first run
#     finishes in minutes and still exercises the coupler (COUPLER_TIME_STEP is
#     PT12M, so fifteen exchanges) and the output path.
#   - the two executables, which are the point of the whole exercise: same
#     source, configured twice, named by their build directory.
#
# Input data comes from /pool/data/ICON/grids/public/mpim (INPUT_ROOT is set in
# mkexp/environments/gb10_hybrid.config).
#
# Generate the run script with config/docker/gb10/make-experiment.sh; see
# config/docker/gb10/README.md.
#

VERSION_ = $$Id: config/docker/gb10/cpl_r2b4_gb10.config 1 2026-09-01 $$
# Baseline: run/mkexp/types/AES/coupled-R02B04L90.config 2 2026-02-27 12:52:05Z k202123

# gb10: single Spark, atmosphere on the GPU and ocean on the CPU.
ENVIRONMENT = gb10_hybrid

# gb10: NONE, not AES/coupled-R02B04L90, because that file's content is inlined
# below rather than layered in. Naming the type would put a second, redundant
# copy of it underneath this file -- harmless today, since mkexp re-merges the
# experiment config last and it therefore still wins, but it would mean a
# future upstream edit to the type silently changes this experiment, which is
# the thing inlining is for. EXP_TYPE is otherwise only descriptive: EXP_KIND
# reaches nothing but the intake job, which this experiment does not run.
EXP_TYPE = NONE

# gb10: output through hiopy -- ICON hands its fields to YAC, and hiopy worker
# ranks aggregate them and write a Zarr store, instead of ICON writing netCDF
# itself. `suppress_default_output` switches DEFAULT.config's own output_nml
# set off and `output/hiopy_core` puts the hiopy ones in its place, together
# with the [hiopy] data request below and `coupled_to_output = true` in both
# model namelists.
#
# To go back to ICON's own writers, swap this line for
#
#   EXP_OPTIONS = output/coupled_test
#
# and drop the [hiopy] section. That is the output configuration the dolpung
# example for this experiment type uses; it is worth taking over falling back
# on DEFAULT.config's, whose atm_2d list asks for tauu_sso -- a variable this
# configuration never allocates, so output setup aborts in
# mo_derived_variable_handling:init_op before the first time step.
#
# Either way the option's own num_io_procs is overridden below: the experiment
# config is merged last, after types, options and the environment, so these
# settings win.
EXP_OPTIONS = suppress_default_output, output/hiopy_core

# gb10: hiopy_core defines its variable groups at these two frequencies, and
# [hiopy]time_agg below has to name the same ones. The option's defaults are
# PT3H and P1D, neither of which completes inside a three-hour chunk, so a run
# this short would produce a Zarr store with no finished time step in it.
HIGH_FREQUENCY_INTERVAL = PT1H
LOW_FREQUENCY_INTERVAL = PT3H

EXP_DESCRIPTION = Coupled AES R2B4/R2B4 on a single GB10 - atmosphere on the GPU and ocean on the CPU


# General setup

PARENT_DIR = /pool/data/ICON/grids/public/mpim/$OCEAN_GRID_ID/ocean/restart/r0001
PARENT_EXP_ID = ler1166
PARENT_DATE = 21000101T000000Z

SCENARIO = ssp370

# Atmosphere setup

ATMO_GRID_ID = 0049
ATMO_GRID_TYPE = R02B04
ATMO_LEVELS = 90

ATMO_TIME_STEP = PT40S
ATMO_RADIATION_TIME_STEP = PT12M

ATMO_USE_TMX = true

# Land setup

LAND_USECASE = jsbach_pfts
LAND_NPFT = 12
LAND_REFERENCE_YEAR = 2015
LAND_WITH_CARBON = false

# Ocean setup

OCEAN_INPUT_SUBDIR = $INPUT_SUBDIR
OCEAN_GRID_ID = 0036
OCEAN_GRID_TYPE = R02B04
OCEAN_LAYER_DEPTHS = "12.0, 10.0, 10.0, 10.0, 10.0, 10.0, 13.0, 15.0, 20.0, 25.0, 30.0, 35.0, 40.0, 45.0, 50.0, 55.0, 60.0, 70.0, 80.0, 90.0, 100.0, 110.0, 120.0, 130.0, 140.0, 150.0, 170.0, 180.0, 190.0, 200.0, 220.0, 250.0, 270.0, 300.0, 350.0, 400.0, 450.0, 500.0, 500.0, 600.0"
OCEAN_LEVEL_200M = 12

OCEAN_TIME_STEP = PT12M

# Ocean biogeochemistry setup

OBGC_EUPHOTIC_LEVELS = 18

# Coupling setup

COUPLER_TIME_STEP = PT12M

# Time control
#
# gb10: three hours in one chunk instead of three days in one. Long enough for
# fifteen coupler exchanges (COUPLER_TIME_STEP = PT12M) and three output steps,
# short enough to be a smoke test. Raise FINAL_DATE, and INTERVAL with it, for
# a real run; leaving INTERVAL below the total length turns this into a restart
# chain, which on a machine without a scheduler runs the chunks back to back in
# the foreground.
#
# Three hours and not one: INTERVAL sets checkpointtimeintval, and
# mo_time_management.f90:371 refuses a checkpoint interval below 2.5 hours when
# divdamp_order = 24, which is what nonhydrostatic_nml above asks for. A
# shorter chunk aborts in atm_crosscheck before the first time step.

FINAL_DATE = 2014-01-20T03:00:00
INITIAL_DATE = 2014-01-20
INTERVAL = PT3H

FILE_INTERVAL = PT3H
OUTPUT_INTERVAL = PT1H

[namelists]

# gb10: hiopy_core's variable lists are written for a DestinE configuration and
# name eight variables this one does not register. Each replacement below was
# checked against the model's own variable list, dumped by running with
# `msg_level = 13` (mo_nh_stepping.f90:1010) -- worth doing rather than reading
# the sources, because AES and ICON-Land build most of their variable names
# programmatically, so grepping for them finds nothing.
#
#   qv2m                        -> huss            2m specific humidity
#   prlr                        -> prls            AES has prls, not prlr; total
#                                                  precipitation pr is in atm_2d_hf
#   qtop, qbot                  -> dropped         only qtop_icecl / qbot_icecl here,
#                                                  which are ice-class containers
#   o3vi                        -> dropped         no column-integrated ozone here
#   o3                          -> xo3             AES registers ozone as xo3. No
#                                                  var_names_dict entry is needed:
#                                                  hiopy prefixes `pl::` itself for a
#                                                  group with is_pressure_level, which
#                                                  is what mo_output_coupling.f90:147
#                                                  names p-level fields.
#   relative_vorticity_on_cells -> vor850          that is the CF long name, not the
#                                                  variable; the variable is `vor`, and
#                                                  hiopy_core's own var_names_dict
#                                                  already maps vor850 -> pl::vor. `vor`
#                                                  is added to atm_3d_pl as well, since
#                                                  nothing else puts it on p-levels and
#                                                  pl::vor would not otherwise exist.
#   hydro_wtr_rootzone_rel_box  -> dropped         only the _gmean_ variant exists;
#                                                  hydro_wtr_rootzone_box is already
#                                                  in land_2d_hf
#   see_grnd_hflx_box           -> sse_grnd_hflx_box    upstream typo
#   pheno_fract_fcp_box         -> pheno_fract_fpc_box  upstream typo
#   to, so, u, v (in oce_2d_hf) -> dropped         they are 3d fields, and the group
#                                                  they sit in declares 2d, so YAC
#                                                  refuses the couple with "collection
#                                                  sizes do not match (40 != 1)". They
#                                                  stay in oce_3d_full, at the lower
#                                                  frequency.
#   A_veloc_v                   -> dropped         it lives on edges
#                                                  (mo_ocean_physics_types.f90:292) and
#                                                  mo_output_coupling only exposes
#                                                  cell variables
#   A_tracer_v_to               -> moved to oce_3d_half   it looked absent, but only because
#                                                  the probe dump covers the
#                                                  atmosphere's lists; A_tracer_v
#                                                  itself is an lcontainer with
#                                                  loutput=.FALSE., and the per-tracer
#                                                  reference A_tracer_v_to is the real
#                                                  variable. It is dimensioned
#                                                  n_zlev+1, so it belongs in the
#                                                  half-level group; leaving it in
#                                                  oce_3d_full makes YAC refuse the
#                                                  couple with "collection sizes do not
#                                                  match (41 != 40)".
  atm_2d_lf = "huss, hfls, hfss, evspsbl, prls, prw, clt, clivi, cllvi, qrvi, qsvi, qgvi, rlds, rlus, rsdt, rsus, sic, sit, tauu, tauv, ts, pres_msl"
  atm_3d_pl = "temp, ua, va, w, xo3, rho, clw, cli, qg, qr, qs, hus, gpsm, vor"
  atm_3d_pl850 = "vor850"
  land_2d_lf = "hydro_runoff_box, hydro_drainage_box, hydro_weq_snow_box, hydro_fract_snow_box, hydro_transpiration_box, sse_grnd_hflx_box, pheno_lai_ta_box, pheno_fract_fpc_box"
  oce_2d_hf = "ssh, mlotst10, conc"
  oce_3d_full = "to, so, u, v"
  oce_3d_half = "w_deriv, tke, A_tracer_v_to"

  [[NAMELIST_atm]]
    [[[dbg_index_nml]]]
      .hide = true
    [[[aes_cop_nml]]]
      aes_cop_config(1)%cinhomi    = 1.0
      aes_cop_config(1)%cinhoml_cfl= 0.4
      aes_cop_config(1)%cinhoml_cfo= 0.4
      aes_cop_config(1)%cinhoml_sf = 0.4
      aes_cop_config(1)%cn1lnd = 50.0
      aes_cop_config(1)%cn1sea = 50.0
      aes_cop_config(1)%cn2lnd = 220.0
      aes_cop_config(1)%cn2sea = 100.0
    [[[aes_cov_nml]]]
      aes_cov_config(1)%cqx = 1.e-6
    [[[aes_phy_nml]]]
      aes_phy_config(1)%dt_mig = $ATMO_TIME_STEP
      aes_phy_config(1)%iqneg_d2p = 2
      aes_phy_config(1)%iqneg_p2d = 2
    [[[aes_rad_nml]]]
      aes_rad_config(1)%vmr_co2 =
      aes_rad_config(1)%vmr_ch4 =
      aes_rad_config(1)%vmr_n2o =
      aes_rad_config(1)%lyr_perp =
      aes_rad_config(1)%yr_perp =
      aes_rad_config(1)%irad_aero = 13
      aes_rad_config(1)%irad_cfc11 = 3
      aes_rad_config(1)%irad_cfc12 = 3
      aes_rad_config(1)%irad_ch4 = 13
      aes_rad_config(1)%irad_co2 = 3
      aes_rad_config(1)%irad_n2o = 13
      aes_rad_config(1)%irad_o3 = 6
      aes_rad_config(1)%isolrad = 2
    [[[aes_vdf_nml]]]
      aes_vdf_config(1)%pr0 = 0.7
      aes_vdf_config(1)%turb = 2
      aes_vdf_config(1)%use_tmx = $ATMO_USE_TMX
    [[[io_nml]]]
      restart_write_mode = joint procs multifile
      write_last_restart = true
    [[[nonhydrostatic_nml]]]
      damp_height = 44000.
      divdamp_order = 24
      divdamp_trans_end = 17500
      divdamp_trans_start = 12500
      divdamp_type = 32
      exner_expol = 0.333
      hbot_qvsubstep = 16000.
      htop_moist_proc = 22500.
      iadv_rhotheta = 2
      igradp_method = 3
      itime_scheme = 4
      ivctype = 2
      l_zdiffu_t = true
      rayleigh_coeff = 1
      thhgtd_zdiffu = 125.
      thslp_zdiffu = 0.02
    [[[parallel_nml]]]
      pio_type =
      # gb10: no dedicated I/O or restart ranks. There are 20 cores in total
      # and 17 ranks already; the workers write instead. num_restart_procs = 0
      # with `joint procs multifile` means all workers take part in the restart
      # (mo_io_config.f90: ALL_WORKERS_INVOLVED), not that restart is off.
      io_proc_chunk_size =
      io_process_stride =
      num_io_procs = 0
      num_restart_procs = 0
      num_prefetch_proc =
    [[[run_nml]]]
      profiling_output = 1
      timers_level = 10
      restart_filename = ${EXP_ID}_restart_atm_<rsttime>.mfr
    [[[extpar_nml]]]
      itype_lwemiss =
    [[[interpol_nml]]]
      rbf_scale_mode_ll =
    [[[sleve_nml]]]
      htop_thcknlimit = 14000.
      max_lay_thckn = 400.
      min_lay_thckn = 25.
      top_height = 75000.
    [[[transport_nml]]]
      ihadv_tracer = 20, 20, 20, 20, 20, 20
      itype_hlimit = 3, 4, 4, 4, 4, 4
      ivadv_tracer = 3, 3, 3, 3, 3, 3
      tracer_names = hus, clw, cli, qr, qs, qg

  [[NAMELIST_lnd]]
    [[[jsb_hd_nml]]]
      bc_filename = bc_land_hd.nc
      use_bifurcated_rivers = false
    [[[jsb_model_nml]]]
      use_tmx = $ATMO_USE_TMX
      fract_filename = bc_land_frac.nc
      init_from_ifs = true
    [[[jsb_sse_nml]]]
      l_supercool = false
    [[[jsb_hydro_nml]]]
      snow_depth_max =
    [[[jsb_turb_nml]]]
      max_ini_rough_m = eval('1.0' if is_set('$ATMO_USE_TMX') else '-1.0')

  [[NAMELIST_oce]]
    [[[dbg_index_nml]]]
      dbg_lat_in = 30.0
      dbg_lon_in = -30.0
      idbg_elev = 5
      idbg_mxmn = 0
      idbg_slev = 1
      idbg_val = 0
      str_mod_tst = all
    [[[io_nml]]]
      restart_write_mode = joint procs multifile
    [[[ocean_diagnostics_nml]]]
      diagnose_for_horizontalvelocity = false
      diagnose_for_tendencies = false
      diagnostics_level = 1
    [[[ocean_dynamics_nml]]]
      l_lhs_direct = false
      l_partial_cells = false
      select_lhs = 1
      solver_max_restart_iterations = 100
      solver_tolerance = 1.0E-10
      minverticallevels = 12
      solver_max_iter_per_restart = 14
      vert_cor_type = 1
    [[[ocean_forcing_nml]]]
      jerlov_atten = 0.08
      jerlov_bluefrac = 0.36
      lcheck_salt_content = false
      lfix_salt_content = false
      limit_elevation = false
      limit_seaice_type = 1
      lswr_jerlov = true
      seaice_limit = 6.0
      tides_mod = 1
      use_tides = false
      type_surfrelax_temp =
      atm_pressure_included_in_icedyn = true
      atm_pressure_included_in_ocedyn = true
    [[[ocean_gentmcwilliamsredi_nml]]]
      gmredi_configuration = 0
      k_tracer_gm_kappa_parameter = 0.0
      k_tracer_isoneutral_parameter = 0.0
    [[[ocean_horizontal_diffusion_nml]]]
      harmonicviscosity_background =
      biharmonicviscosity_background = 0.0
      biharmonicviscosity_reference = 2.7E-2
      biharmonicviscosity_scaling = 4
      harmonicviscosity_reference = 2.0
      velocitydiffusion_order = 2
    [[[ocean_tracer_transport_nml]]]
      threshold_min_t = -2.0
    [[[ocean_vertical_diffusion_nml]]]
      alpha_tke = 30.0
      c_eps = 0.7
      c_k = # use default
      cd = 3.75
      kappam_max = 100.0
      kappam_min = 0.0
      mxl_min = 1.d-8
      only_tke = true
      ppscheme_type = 0
      tke_min = 1.d-6
      tke_mxl_choice = 2
      tke_surf_min = 1.d-4
      use_lbound_dirichlet = false
      use_ubound_dirichlet = false
      vert_mix_type = 2
      # The following settings were deleted as a precaution measure:
      bottom_drag_coeff =
      convection_instabilitythreshold =
      lambda_wind =
      richardsondiffusion_threshold =
      salinity_verticaldiffusion_background =
      temperature_verticaldiffusion_background =
      tracer_convection_mixingcoefficient =
      tracer_richardsoncoeff =
      use_wind_mixing =
      velocity_richardsoncoeff =
      velocity_verticaldiffusion_background =
      clc = 0.15 # Factor in vertical Langmuir circulation (Axell, 2002: clc=0.1)
      l_lc = true # Use Langmuir parameterisation (Axell, 2002)
    [[[parallel_nml]]]
      # gb10: as for the atmosphere -- workers do the I/O and the restart.
      io_proc_chunk_size =
      io_process_stride =
      num_io_procs = 0
      num_restart_procs = 0
      p_test_run = false
      pio_type =
      l_fast_sum = false
    [[[run_nml]]]
      restart_filename = ${EXP_ID}_restart_oce_<rsttime>.mfr

  [[NAMELIST_atm, NAMELIST_oce]]
    [[[sea_ice_nml]]]
      albedow_sim = 0.10
      albi = 0.70
      albim = 0.65
      albs = 0.80
      albsm = 0.65
      i_ice_dyn = 1
      i_ice_therm = 1
      leadclose_1 = 0.25
      leadclose_2n = 0.666

  [[icon_master.namelist]]
    [[[jsb_control_nml]]]
      debug_level = 0
      timer_level = 0
    [[[master_nml]]]
    [[[master_time_control_nml]]]
      experimentstartdate = $INITIAL_DATE
      experimentstopdate = $FINAL_DATE
    [[[time_nml]]]
      is_relative_time = true

  [[coupling.yaml]]
    .use_template = coupling_passthrough.yaml

[files]

  [[atmosphere]]
    [[[model]]]
      [[[[data]]]]
        .sub_dir = data
        lsdata.nc =
        ECHAM6_CldOptProps.nc =
        rrtmgp-cloud-optics-coeffs-lw.nc = ECHAM6_CldOptProps_rrtmgp_lw.nc
        rrtmgp-cloud-optics-coeffs-sw.nc = ECHAM6_CldOptProps_rrtmgp_sw.nc
      [[[[rrtmgp]]]]
        .sub_dir = data
        coefficients_lw.nc = rrtmgp-gas-lw-g128.nc
        coefficients_sw.nc = rrtmgp-gas-sw-g112.nc
    [[[independent]]]
      .sub_dir = independent
      bc_greenhouse_gases.nc = greenhouse_gases/greenhouse_$SCENARIO.nc
      [[[[solar_irradiance]]]]
        .sub_dir = solar_radiation/3.2
        bc_solar_irradiance_sw_b14.nc = swflux_14band_cmip6_1850-2299-v3.2.nc
    [[[mapped]]]
      hd_mask.nc = icon_grid_${ATMO_GRID_ID}_${ATMO_GRID_TYPE}_G.nc
      [[[[initial]]]]
        .sub_dir = initial_condition/r0001
        ifs2icon.nc = ifs2icon_1979010100_${ATMO_GRID_TYPE}_G.nc
      [[[[ozone]]]]
        .offsets = 0
        .set label = 2014
        .sub_dir = ozone/r0001
        bc_ozone.nc = bc_ozone_historical_$${label}.nc
      [[[[ocean_surface]]]]
        .offsets = 0
        .set label = 1979_2016
        .sub_dir = sst_and_seaice/r0001
        bc_sic.nc = bc_sic_$${label}.nc
        bc_sst.nc = bc_sst_$${label}.nc
      [[[[aerosols]]]]
        .offsets = -1, 0, 1
        .set label = 1849, 1849:%year, 2022:2021
        .sub_dir = aerosol_kinne/r0001
        bc_aeropt_kinne_lw_b16_coa.nc = .
        bc_aeropt_kinne_sw_b14_coa.nc = .
        bc_aeropt_kinne_sw_b14_fin_%year.nc = bc_aeropt_kinne_sw_b14_fin_$${label}.nc
    [[[restart]]]
      multifile_restart_atm.mfr = ${EXP_ID}_restart_atm_$${start_stamp}Z.mfr
      restart_atm_DOM01.nc =

  [[land]]
    [[[mapped]]]
      .sub_dir = $ATMO_GRID_ID-$OCEAN_GRID_ID/land/r0100
      bc_land_hd.nc = hdpara_r2b4_${ATMO_GRID_ID}_${OCEAN_GRID_ID}_sc_hfrac_s_v1.nc
    [[[hydro]]]
      .hide = true

  [[ocean]]
    [[[grids]]]
      .sub_dir = $OCEAN_GRID_ID
    [[[restart]]]
      multifile_restart_oce.mfr = ${EXP_ID}_restart_oce_$${start_stamp}Z.mfr
      restart_oce_DOM01.nc =

# gb10: the hiopy data request. hiopy_core's defaults are sized for a
# production DestinE run -- 16 workers writing a healpix zoom-8 hierarchy --
# and none of that fits here.
[hiopy]
  # Two workers, taken out of the ocean's share: run_gb10_hybrid.tmpl subtracts
  # them from oce_procs, so the job stays at 17 ranks (1 atm + 14 oce + 2).
  nr_of_workers = 2

  # build-icon.sh's venv, which is where its hiopy step installs hiopy-worker.
  venv = $SRC_DIR/experiments/py_env

  relative_path_to_dataset = $EXP_ID.zarr
  storage_backend = file
  # The whole run is one chunk; the default 24 would leave it unfinished.
  simulated_hours_per_chunk = 3
  time_agg = $HIGH_FREQUENCY_INTERVAL, $LOW_FREQUENCY_INTERVAL

  [[grid]]
    # The model's own grids, not healpix. hiopy_core defaults to a healpix
    # zoom-8 hierarchy, which at 786432 cells would be a 38x upsampling of an
    # R2B4 atmosphere -- a lot of interpolation to store no extra information.
    # `icon` writes on the source grid and needs only the grid files, which are
    # the same ones the model reads.
    type = icon
    [[[atmo]]]
      path_to_grid_file = $ATMO_INPUT_DIR/$ATMO_GRID_ID/icon_grid_${ATMO_GRID_ID}_${ATMO_GRID_TYPE}_G.nc
    [[[ocean]]]
      path_to_grid_file = $OCEAN_INPUT_DIR/$OCEAN_GRID_ID/icon_grid_${OCEAN_GRID_ID}_${OCEAN_GRID_TYPE}_O.nc

[jobs]
  # gb10: the pre job builds the Zarr store and the data request JSON before
  # the first run, and it imports hiopy, xarray and isodate. The default
  # python3 is the image's interpreter, which has none of them; hiopy lives in
  # build-icon.sh's venv.
  [[pre]]
    python3 = $SRC_DIR/experiments/py_env/bin/python
  [[run]]
    # gb10: `run` alone. intake and mon need cdo and a python stack that is not
    # in this image, and with a single chunk `run` does not re-trigger itself
    # anyway -- it only would if INTERVAL were shorter than the total length.
    .trigger = run
    nodes = 1
    time_limit = 00:30:00
    [[[hybrid]]]
      # gb10: the whole point of the hybrid layout. Same source, configured
      # twice -- one OpenACC build for the atmosphere, one plain CPU build for
      # the ocean -- launched as one MPMD job and talking through YAC. They are
      # told apart by their build directory, not by their file name, which is
      # why neither is called icon-gpu. Both are made by
      # config/docker/gb10/build-icon.sh, which puts them under
      # $SRC_DIR/experiments by default; change these if you built with
      # -d ENV_DIR or $ICON_ENV_DIR pointing somewhere else.
      [[[[atm]]]]
        exec = $SRC_DIR/experiments/build_dir/icon_gpu_nvhpc-25.9/bin/icon
        gpus_per_node = 1
      [[[[oce]]]]
        exec = $SRC_DIR/experiments/build_dir/icon_cpu_nvhpc-25.9/bin/icon
        # 20 cores, minus the atmosphere rank, minus a couple left for its
        # host-side work and for mpirun's own threads.
        cpus_per_node = 16
  [[run_start]]
    [[[namelists]]]
      [[[[icon_master.namelist]]]]
        [[[[[jsb_control_nml]]]]]
          restart_jsbach = false
        [[[[[master_nml]]]]]
          lrestart = false
      [[[[NAMELIST_oce]]]]
        [[[[[ocean_initialconditions_nml]]]]]
          initialize_fromrestart = true # do not initialize ocean
    [[[files]]]
      [[[[atmosphere]]]]
        [[[[[restart_data]]]]]
          .hide = true
        [[[[[restart]]]]]
          .hide = true
      [[[[ocean]]]]
        [[[[[restart_data]]]]]
          .hide = true
        [[[[[restart]]]]]
          .base_dir = $OCEAN_PARENT_DIR
          restart_oce_DOM01.nc = ${OCEAN_PARENT_EXP_ID}_restart_oce_${OCEAN_PARENT_DATE}.nc
          multifile_restart_oce.mfr =
  [[mon]]
    time_limit = 5
    mean_op = dayavg
